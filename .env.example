# Document Manager environment template.
#
#   cp .env.example .env
#
# Then edit .env. It is git-ignored; never commit real credentials. Docker
# Compose reads this file automatically.

# MongoDB connection string used by the app.
#
# Cloud (MongoDB Atlas) — keep an explicit database name in the path, and
# percent-encode special characters in the password (`@` → `%40`). Keep the
# value quoted: an unquoted `&` in the query string truncates the line when the
# file is sourced by a shell (`set -a; . ./.env`).
#   MONGO_URI="mongodb+srv://<user>:<password>@cluster0.vhxrozb.mongodb.net/cse?retryWrites=true&w=majority"
#
# Bundled local MongoDB, started with `docker compose --profile local-db up`:
MONGO_URI=mongodb://mongo:27017/cse

# Signing key for session tokens. Change this in any shared environment.
JWT_SECRET_KEY=super-secret-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRES=86400

# Set to true when the app is served over HTTPS.
COOKIE_SECURE=false

# Host port for the web app.
APP_PORT=5000

# Optional target for `python copy_to_atlas.py` (also accepted as --target).
# MONGO_TARGET_URI=mongodb+srv://<user>:<password>@cluster0.vhxrozb.mongodb.net/cse?retryWrites=true&w=majority
